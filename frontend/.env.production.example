# Server-only URL used by Next.js rewrites. Do not expose private backend URLs
# through a NEXT_PUBLIC_* variable.
FPL_API_SERVER_URL=https://api.example.com

# Set only for a deliberately co-located production API reached over loopback.
# FPL_ALLOW_LOCAL_API=true

# Public Supabase project configuration. The publishable key is designed for
# browser use; row-level security remains mandatory. Never add a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only credential used solely by the authenticated account-deletion route.
# Never prefix this value with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Canonical production origin used in email/OAuth redirects (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://squadmetric.example.com

# Public contact shown in the privacy policy.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
