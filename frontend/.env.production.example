# Server-only URL used by Next.js rewrites. Do not expose private backend URLs
# through a NEXT_PUBLIC_* variable.
FPL_API_SERVER_URL=https://api.example.com

# Set only for a deliberately co-located production API reached over loopback.
# FPL_ALLOW_LOCAL_API=true

# Canonical production origin (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://squadmetric.example.com

# Public contact shown in the privacy policy.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
