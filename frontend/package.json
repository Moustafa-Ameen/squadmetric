    "test:drafts": "node --experimental-strip-types --test lib/draftWorkspace.test.mjs",
    "test:decision-center": "node --experimental-strip-types --test lib/decisionCenter.test.mjs",
    "test:deadline": "node --experimental-strip-types --test lib/deadlineIntelligence.test.mjs",
    "test:review": "node --experimental-strip-types --test lib/reviewMode.test.mjs",
    "test:auth": "node --experimental-strip-types --test lib/auth.test.mjs lib/fplTeam.test.mjs lib/accountAccess.test.mjs",
    "test:unit": "node --experimental-strip-types --test lib/search.test.mjs lib/screenshotTeam.test.mjs lib/squadMetrics.test.mjs lib/decisionState.test.mjs lib/draftWorkspace.test.mjs lib/decisionCenter.test.mjs lib/deadlineIntelligence.test.mjs lib/reviewMode.test.mjs lib/auth.test.mjs lib/fplTeam.test.mjs lib/accountAccess.test.mjs lib/managerState.test.mjs lib/api.test.mjs lib/launchContract.test.mjs",
